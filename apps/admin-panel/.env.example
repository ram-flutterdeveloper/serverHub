# Backend API base URL (the express app mounts every router under /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

NEXT_PUBLIC_APP_NAME=ServiceHub Admin

# Socket.IO server origin (no /api/v1 suffix). The backend authenticates the
# handshake with the access token sent as `auth.token`.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Base URL used to resolve the upload paths returned by the API
# (e.g. /uploads/packages/1712-ab.webp). It may either be the server origin or
# include the /uploads suffix; `resolveMediaUrl` normalises both forms.
NEXT_PUBLIC_STORAGE_URL=http://localhost:5000/uploads